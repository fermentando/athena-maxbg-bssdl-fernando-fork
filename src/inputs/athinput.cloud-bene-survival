<job>
maxout          = 3         # Number of output files
num_domains     = 1
problem_id      = cloud

<output1>
dt              = 0.5
out_fmt         = hst

<output2>
dt              = 1.0
out             = prim
out_fmt         = vtk

<output3>
dt              = 10.0
out_fmt         = rst

<time>
cour_no         = 0.3
nlim            = 2000000.0
tlim            = 950.0

<domain1>
NGrid_x1        = 10
NGrid_x2        = 2
NGrid_x3        = 2
Nx1             = 480.0
Nx2             = 96.0
Nx3             = 96.0
bc_ix2          = 2
bc_ix3          = 2
bc_ox1          = 2.0
bc_ox2          = 2
bc_ox3          = 2
level           = 0.0
x1max           = 135.0
x1min           = -15.0
x2max           = 15.0
x2min           = -15.0
x3max           = 15.0
x3min           = -15.0

<problem>
# Defined by physics
gamma           = 1.66666666667 #Adiabatic exponent

# Remaining static, predefined by Max
tnotcool        = 0.04          # switch off cooling above this T
dr              = 0.046875      # border of cloud in units of r_cl
dtmin           = 1e-09 

#Defined by user 
r_cloud         = 10           # radius of cloud
drat            = 100.0         # density ratio
T_cloud         = 10000
M_wind          = 5e-12             # Mach Number of hot wind

#Deprecated
#dp              = -0.6 # sets global pressure. P = Gamma - 1 + dp
#vflow           = 0.5 # flow speed

<par_end>